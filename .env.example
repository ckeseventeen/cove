# Copy this file to `.env` and fill in your own values. Never commit `.env`.
# The app reads it at runtime in development; only `npm run bundle:mac:personal`
# embeds it into a build, which must not be distributed.

# Baidu Netdisk Open Platform application
NIMBUS_BAIDU_APP_KEY=
NIMBUS_BAIDU_SECRET_KEY=
NIMBUS_BAIDU_REDIRECT_URI=http://127.0.0.1:53682/oauth/baidu/callback

# TMDB API Read Access Token (posters, overviews, Chinese titles)
NIMBUS_TMDB_READ_ACCESS_TOKEN=
