{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cove",
  "version": "0.1.0",
  "identifier": "app.cove.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Cove",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false,
        "trafficLightPosition": {
          "x": 20,
          "y": 28
        },
        "transparent": true,
        "windowEffects": {
          "effects": [
            "sidebar"
          ],
          "state": "followsWindowActiveState"
        },
        "resizable": true
      },
      {
        "label": "player-controls",
        "title": "Cove Player Controls",
        "url": "index.html?player-controls=1",
        "width": 1280,
        "height": 800,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; media-src 'self' http://127.0.0.1:*; img-src 'self' asset: http://asset.localhost data: https://*.mzstatic.com https://image.tmdb.org; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "category": "Entertainment",
    "shortDescription": "Your private personal media haven",
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
